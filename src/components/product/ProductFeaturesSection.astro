---
import SectionHeader from '../SectionHeader.astro';
import Icon from '../icons/Icon.astro';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/starwind/card';
import type { ProductFeatureGroup } from '../../data/products';
import { getLocaleFromAstro, getTranslations } from '../../i18n';

interface Props {
  features: string[];
  productName: string;
  featureGroups?: ProductFeatureGroup[];
  sectionTitle?: string;
  sectionDesc?: string;
}

const locale = getLocaleFromAstro(Astro);
const catalog = getTranslations(locale).catalog ?? {};
const { features, productName, featureGroups, sectionTitle, sectionDesc } = Astro.props;
const groups = featureGroups?.filter((group) => group.items.length > 0) ?? [];
const featuresHeading = sectionTitle ?? catalog.whatsIncluded ?? "What's included";

function featureListTwoColumns(groupName: string): boolean {
  return groupName === 'MAIN OPTIONS' || groupName === 'ATTRIBUTES CHANGER OPTIONS';
}

const moduleNoteTemplate = catalog.moduleNote ?? 'Every module shipped with {name}.';
const featuresDesc = sectionDesc ?? moduleNoteTemplate.replace('{name}', productName);
---

<section id="modules" class="product-detail__features-anchor py-12 md:py-16" aria-labelledby="product-features-title">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader
      eyebrow={catalog.modulesEyebrow ?? ''}
      title={featuresHeading}
      desc={featuresDesc}
      titleId="product-features-title"
    />

    {
      groups.length > 0 ? (
        <div class="product-feature-groups-stack mt-10">
          {groups.map((group) => (
            <div class="product-feature-groups-stack__item w-full">
              <Card class="flex w-full flex-col border-border/80 bg-muted/15 py-0 transition-[transform,box-shadow,border-color] duration-300 hover:-translate-y-0.5 hover:border-primary/35 hover:shadow-lg hover:shadow-primary/5">
                <CardHeader class="product-feature-card-header space-y-1 border-b border-border/60 pb-2.5 pt-5">
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <CardTitle class="text-xs font-semibold uppercase tracking-wider leading-snug">{group.name}</CardTitle>
                    <span class="text-xs font-medium tabular-nums text-muted-foreground">
                      {group.items.length} {group.items.length === 1 ? (catalog.optionOne ?? 'option') : (catalog.optionMany ?? 'options')}
                    </span>
                  </div>
                </CardHeader>
                <CardContent class="product-feature-card-body pb-5 pt-2.5">
                  <ul
                    class:list={[
                      'product-feature-groups-list text-sm text-muted-foreground',
                      featureListTwoColumns(group.name) && 'product-feature-groups-list--two-col',
                    ]}
                  >
                    {group.items.map((item) => {
                      const showName = item.name !== group.name;
                      return (
                        <li class="flex items-start gap-2.5">
                          <Icon name="check" size={15} class="product-feature-check mt-0.5 shrink-0 icon-app--primary" />
                          <span class="min-w-0">
                            {showName && <span class="font-medium text-foreground">{item.name}</span>}
                            {item.desc && (
                              <span
                                class:list={[
                                  'product-feature-desc block text-muted-foreground',
                                  showName && 'mt-0.5',
                                ]}
                              >
                                {item.desc}
                              </span>
                            )}
                          </span>
                        </li>
                      );
                    })}
                  </ul>
                </CardContent>
              </Card>
            </div>
          ))}
        </div>
      ) : (
        <ul class="product-detail__features mt-10 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
          {features.map((feature) => (
            <li class="flex items-start gap-2.5 rounded-xl border border-border/80 bg-muted/15 px-4 py-3 text-sm text-muted-foreground transition-colors hover:border-primary/25 hover:bg-muted/30">
              <Icon name="check" size={15} class="product-feature-check mt-0.5 shrink-0 icon-app--primary" />
              <span>{feature}</span>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .product-feature-desc {
    display: block;
    overflow-wrap: anywhere;
  }

  .product-feature-groups-stack {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  .product-feature-groups-list {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .product-feature-groups-list--two-col {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: 1.5rem;
    row-gap: 0.625rem;
  }

  @media (min-width: 768px) {
    .product-feature-groups-list--two-col {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
