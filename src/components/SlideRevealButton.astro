---
import Icon from './icons/Icon.astro';
import type { IconName } from './icons/types';
import { isZadeyoHref, CHECKOUT_LINK_REL } from '../config/checkout';

interface Props {
  href: string;
  class?: string;
  ariaLabel?: string;
  icon?: IconName;
  scrollTarget?: string;
  size?: 'sm' | 'lg';
  block?: boolean;
  [key: string]: unknown;
}

const { href, class: className, ariaLabel, scrollTarget, icon = 'arrowRight', size, block, ...rest } = Astro.props;
const isCheckout = isZadeyoHref(href);
---

<a
  href={href}
  class:list={['slide-reveal-btn', size === 'lg' && 'slide-reveal-btn--lg', block && 'slide-reveal-btn--block', className]}
  aria-label={ariaLabel}
  data-scroll-target={scrollTarget}
  {...rest}
  {...(isCheckout
    ? { rel: CHECKOUT_LINK_REL, 'data-astro-reload': true, 'data-astro-prefetch': 'false' }
    : {})}
>
  <span class="slide-reveal-btn__icon" aria-hidden="true">
    <Icon name={icon} size={18} class="slide-reveal-btn__svg" />
  </span>
  <span class="slide-reveal-btn__text">
    <slot />
  </span>
</a>
