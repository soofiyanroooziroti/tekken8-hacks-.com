---
import { getLocaleFromAstro, getTranslations } from '../i18n';
const locale = getLocaleFromAstro(Astro);
const t = getTranslations(locale);
import '../styles/product-cheat-page.css';
import { getProductPages } from '../data/products';
import { cheatTierIcons, productCategoryIcons } from '../data/sectionIcons';
import SectionHeader from './SectionHeader.astro';
import CatalogCard from './CatalogCard.astro';
import { productPath } from '../utils/path';
import { catalogBuyLabel, catalogFeatureTotal, catalogPillLabel } from '../utils/catalog-card';

const productPages = getProductPages(locale);
const s = t.products;
const pricing = t.pricing as Record<string, string>;

const mainCheat = productPages.find((p) => p.slug === 'tekken-8-hack');
const addOns = productPages.filter((p) => p.slug !== 'tekken-8-hack');
const addOnsHeading = (s as { addOnsHeading?: string }).addOnsHeading ?? 'Add-ons';

function cardIcon(product: (typeof productPages)[number]) {
  if (product.kind === 'tier') {
    return cheatTierIcons[product.name] ?? 'crosshair';
  }
  return productCategoryIcons[product.category ?? ''] ?? 'package';
}

function cardLabel(product: (typeof productPages)[number]) {
  return catalogPillLabel(product);
}
---

<section id="products" class="py-16 md:py-24" aria-labelledby="products-title">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader eyebrow={s.eyebrow} title={s.title} desc={s.subtitle} titleId="products-title" />

    <div class="products-section__stack mt-12">
      {
        mainCheat && (
          <CatalogCard
            class="catalog-card--products-section catalog-card--products-featured"
            label={cardLabel(mainCheat)}
            title={mainCheat.title}
            href={productPath(mainCheat.slug)}
            buyUrl={mainCheat.buyUrl}
            productSlug={mainCheat.slug}
            features={mainCheat.features}
            featureTotal={catalogFeatureTotal(mainCheat)}
            icon={cardIcon(mainCheat)}
            variant={mainCheat.variant}
            featured
            featuredRibbon={pricing.recommended ?? 'Recommended'}
            buyEmphasis
            showStatusPill
            featuredSplitLayout
            buyLabel={catalogBuyLabel(mainCheat.slug)}
            viewLabel="View details"
            maxFeatures={mainCheat.features.length}
          />
        )
      }

      {
        addOns.length > 0 && (
          <div class="products-section__addons">
            <h2 class="section-header__title mb-1" id="products-addons-title">
              {addOnsHeading}
            </h2>
            <div
              class="products-section__addons-grid"
              aria-labelledby="products-addons-title"
            >
              {
                addOns.map((product) => (
                  <CatalogCard
                    class="catalog-card--products-section catalog-card--products-addon"
                    label={cardLabel(product)}
                    title={product.title}
                    href={productPath(product.slug)}
                    buyUrl={product.buyUrl}
                    productSlug={product.slug}
                    features={product.features}
                    featureTotal={catalogFeatureTotal(product)}
                    icon={cardIcon(product)}
                    buyEmphasis
                    buyLabel={catalogBuyLabel(product.slug)}
                    viewLabel="View details"
                    maxFeatures={3}
                  />
                ))
              }
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>
