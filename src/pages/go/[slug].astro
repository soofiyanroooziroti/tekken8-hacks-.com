---
import { CHECKOUT, CHECKOUT_SLUG_TO_PRODUCT, type CheckoutProduct } from '../../config/checkout';
import { DISCORD_INVITE_URL } from '../../config/checkout-redirects.mjs';

export function getStaticPaths() {
  const checkout = Object.entries(CHECKOUT_SLUG_TO_PRODUCT).map(([slug, product]) => ({
    params: { slug },
    props: { destination: CHECKOUT[product as CheckoutProduct] },
  }));

  return [
    ...checkout,
    { params: { slug: 'discord' }, props: { destination: DISCORD_INVITE_URL } },
  ];
}

interface Props {
  destination: string;
}

const { destination } = Astro.props;
const zadeyoOrigin = 'https://zadeyo.com';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting…</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href={zadeyoOrigin} crossorigin />
    <link rel="dns-prefetch" href={zadeyoOrigin} />
    <meta http-equiv="refresh" content={`1;url=${destination}`} />
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        font-family: system-ui, sans-serif;
        background: #0a0a0a;
        color: #e5e5e5;
      }
      a {
        color: #a78bfa;
      }
    </style>
    <script is:inline define:vars={{ destination }}>
      (() => {
        const params = new URLSearchParams(window.location.search);
        const plan = params.get('plan');
        let url = destination;
        if (plan) {
          url += (url.includes('?') ? '&' : '?') + 'plan=' + encodeURIComponent(plan);
        }
        const link = document.getElementById('checkout-fallback');
        if (link) link.setAttribute('href', url);
        window.location.replace(url);
      })();
    </script>
  </head>
  <body>
    <p>
      Redirecting to secure checkout…
      <a id="checkout-fallback" href={destination}>Click here if you are not redirected</a>.
    </p>
  </body>
</html>